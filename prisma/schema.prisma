generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String
  name          String
  role          String              @default("user") // "user", "admin", "ai"
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  children             ParentChild[]
  parentReports        ParentReport[]
  questFollows         ParentQuestFollow[]
  interestAuditEvents  InterestAuditEvent[]
  discoveryRatings     DiscoveryRating[]
  acknowledgedAlerts   ReliabilityAlert[]
}

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  children  Child[]
}

model Child {
  id                 String              @id @default(cuid())
  accessCodeId       String?
  name               String?
  locale             String              @default("id")
  dateOfBirth        DateTime?           // Parent-provided. Drives age-band policy via src/lib/age.
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accessCode         AccessCode?         @relation(fields: [accessCodeId], references: [id])
  discoveries        Discovery[]
  quests             Quest[]
  galleryEntries     GalleryEntry[]
  squadMemberships   SquadMember[]
  parentLinks        ParentChild[]
  parentReports      ParentReport[]
  parentQuestFollows ParentQuestFollow[]
  interestSignals    InterestSignal[]
  interestProfiles   ChildInterestProfile[]
  interestAssessments MissionInterestAssessment[]
  zpdState           ChildZpdState?
  zpdSnapshots       ChildZpdSnapshot[]
}

model Discovery {
  id              String   @id @default(cuid())
  childId         String
  type            String // "artifact" or "story"
  fileUrl         String?
  aiAnalysis      String? // JSON stored as text for SQLite
  detectedTalents String? // JSON stored as text for SQLite
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  child           Child    @relation(fields: [childId], references: [id])
  quests          Quest[]
  interestSignals InterestSignal[]
  ratings         DiscoveryRating[]
}

model Quest {
  id            String              @id @default(cuid())
  childId       String
  discoveryId   String?
  dream         String
  localContext  String
  status        String              @default("active") // "active", "completed", "abandoned"
  generatedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  child         Child               @relation(fields: [childId], references: [id])
  discovery     Discovery?          @relation(fields: [discoveryId], references: [id])
  missions        Mission[]
  galleryEntry    GalleryEntry?
  parentFollows   ParentQuestFollow[]
  interestSignals InterestSignal[]
}

model Mission {
  id               String            @id @default(cuid())
  questId          String
  day              Int // 1-7
  title            String
  description      String
  instructions     String // JSON stored as text for SQLite
  materials        String // JSON stored as text for SQLite
  tips             String // JSON stored as text for SQLite
  status           String            @default("locked") // "locked", "available", "in_progress", "completed"
  proofPhotoUrl    String?
  phase            String?           // ZPD scaffold phase: "high" | "medium" | "low"
  intensityHint    Float?            // ZPD anchor score used to calibrate this day's task
  intent           String?           // short text intent (e.g., "stretch", "stabilize", "consolidate")
  estimatedMinutes Int?              // Upper bound enforced per age band; see src/lib/ai/quest/age-caps.
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quest            Quest             @relation(fields: [questId], references: [id])
  mentorSession       MentorSession?
  adjustmentEvents    AdjustmentEvent[]
  interestAssessments MissionInterestAssessment[]
  interestSignals     InterestSignal[]

  @@unique([questId, day])
}

model GalleryEntry {
  id             String   @id @default(cuid())
  childId        String
  questId        String   @unique
  imageUrl       String
  talentCategory String
  country        String?
  coordinates    String? // JSON stored as text for SQLite (lat/lng)
  questContext   String? // JSON stored as text for SQLite (quest title, dream, mission summaries)
  clusterGroup   String?
  talentTags     String? // JSON array: [{ name: "Engineering", confidence: 0.95 }, ...]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  child           Child    @relation(fields: [childId], references: [id])
  quest           Quest    @relation(fields: [questId], references: [id])
  interestSignals InterestSignal[]
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String // IP or composite key (e.g., "ip:endpoint")
  endpoint   String   @default("default") // e.g., "login", "register"
  count      Int      @default(1)
  resetAt    DateTime // When the sliding window resets

  @@unique([identifier, endpoint])
  @@index([resetAt])
}

model InterestSignal {
  id                String   @id @default(cuid())
  childId           String
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  taxonomyVersion   String   @default("v1")
  interestKey       String
  source            String
  dimension         String
  strength          Float
  confidence        Float    @default(1)
  discoveryId       String?
  questId           String?
  missionId         String?
  reflectionEntryId String?
  galleryEntryId    String?
  metadataJson      String?  // JSON stored as text for SQLite
  observedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  discovery         Discovery?      @relation(fields: [discoveryId], references: [id])
  quest             Quest?          @relation(fields: [questId], references: [id])
  mission           Mission?        @relation(fields: [missionId], references: [id])
  reflectionEntry   ReflectionEntry? @relation(fields: [reflectionEntryId], references: [id])
  galleryEntry      GalleryEntry?   @relation(fields: [galleryEntryId], references: [id])

  @@index([childId, interestKey])
  @@index([childId, observedAt])
  @@index([source])
}

model ChildInterestProfile {
  id              String    @id @default(cuid())
  childId         String
  child           Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  taxonomyVersion String    @default("v1")
  interestKey     String
  score           Float     @default(0)
  confidence      Float     @default(0)
  signalCount     Int       @default(0)
  /// Distinct observation days seen for this child × interestKey.
  distinctDays    Int       @default(0)
  /// First and last observation timestamps used for sustained-vs-fleeting classification.
  firstSignalAt   DateTime?
  lastSignalAt    DateTime?
  trend           String    @default("stable")
  /// "fleeting" (one-shot) | "emerging" (multi-session, <14d span) | "sustained" (≥3 days × ≥14d span).
  /// Spec ref: Katalis.docx §6.1 — distinguish fleeting vs sustained interests.
  stability       String    @default("fleeting")
  summary         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([childId, taxonomyVersion, interestKey])
  @@index([childId, score])
}

model MissionInterestAssessment {
  id                 String   @id @default(cuid())
  childId            String
  child              Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  missionId          String
  mission            Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  taxonomyVersion    String   @default("v1")
  interestKey        String
  explicitRating     Int?
  parentRating       Int?
  childRating        Int?
  observedEngagement Int?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([childId, missionId, interestKey])
  @@index([childId, missionId])
}

model InterestAuditEvent {
  id           String   @id @default(cuid())
  childId      String?
  actorUserId  String?
  eventType    String
  entityType   String
  entityId     String?
  beforeJson   String?  // JSON stored as text for SQLite
  afterJson    String?  // JSON stored as text for SQLite
  metadataJson String?  // JSON stored as text for SQLite
  createdAt    DateTime @default(now())
  actorUser    User?    @relation(fields: [actorUserId], references: [id])

  @@index([childId])
  @@index([eventType])
  @@index([createdAt])
}

model ModerationEvent {
  id          String    @id @default(cuid())
  sourceType  String // "discovery", "quest", "gallery", "flag"
  sourceId    String? // ID of the related entity (discovery, quest, gallery entry)
  contentType String // "text", "image", "audio"
  contentHash String? // Hash of the content for dedup
  status      String    @default("pending") // "pending", "approved", "blocked", "flagged", "redirected"
  category    String? // "violence", "self_harm", "sexual", "hate", "harassment", "spam", "other"
  severity    String? // "low", "medium", "high", "critical"
  confidence  Float? // AI confidence score for the moderation decision
  aiReasoning String? // AI explanation for the moderation decision
  childId     String? // If applicable
  reviewerId  String? // Admin user who reviewed
  reviewedAt  DateTime?
  metadata    String? // JSON stored as text — additional context
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sourceType, status])
  @@index([status, createdAt])
  @@index([childId])
}

model MentorSession {
  id              String            @id @default(cuid())
  missionId       String            @unique
  childId         String
  questId         String
  status          String            @default("active") // "active", "completed"
  adjustmentCount Int               @default(0)
  /// Tracks the soft check-in state machine: when true, next medium/high
  /// frustration triggers a Small Adjustment instead of another check-in.
  checkinPending  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  mission         Mission           @relation(fields: [missionId], references: [id])
  messages        MentorMessage[]
  adjustments     AdjustmentEvent[]

  @@index([childId])
  @@index([questId])
}

model MentorMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String // "child" or "mentor"
  content   String
  meta      String? // JSON stored as text — { quickReply?, suggestions?, frustrationLevel? }
  createdAt DateTime      @default(now())
  session   MentorSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}

model AdjustmentEvent {
  id                     String        @id @default(cuid())
  sessionId              String
  missionId              String
  originalInstructions   String // JSON stored as text — original instruction array
  simplifiedInstructions String // JSON stored as text — simplified instruction array
  reason                 String // "frustration_detected", "child_requested", "time_based"
  createdAt              DateTime      @default(now())
  session                MentorSession @relation(fields: [sessionId], references: [id])
  mission                Mission       @relation(fields: [missionId], references: [id])

  @@index([missionId])
}

model ReflectionEntry {
  id              String    @id @default(cuid())
  childId         String
  questId         String
  missionDay      Int // Which day the reflection is for (1-7)
  type            String // "text" or "voice"
  content         String // Text content or transcription
  fileUrl         String? // Voice recording URL if type is "voice"
  /// Expiry timestamp for voice recordings stored in R2.
  /// Set to createdAt + 365 days for voice type. Retention cron deletes R2
  /// file and nulls this field when expired. COPPA biometric data rule.
  fileExpiresAt   DateTime?
  aiSummary       String? // AI-generated summary of the reflection
  createdAt       DateTime  @default(now())
  interestSignals InterestSignal[]

  @@index([childId])
  @@index([questId])
  @@index([fileExpiresAt])
}

model Badge {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "first_step", "week_warrior"
  category  String // "progress", "creativity", "reflection", "mentorship"
  tier      String   @default("bronze") // "bronze", "silver", "gold"
  icon      String // emoji identifier, e.g. "🎯"
  createdAt DateTime @default(now())

  @@index([category])
}

model ChildBadge {
  id        String   @id @default(cuid())
  childId   String
  badgeSlug String // references Badge.slug — not a FK to allow code-first definitions
  questId   String? // Quest context when earned (nullable for lifetime badges)
  trigger   String // "mission_complete", "reflection", "mentor_message", "adjustment"
  metadata  String? // JSON stored as text — additional context (e.g. mission day)
  createdAt DateTime @default(now())

  @@unique([childId, badgeSlug]) // Each badge earned once per child
  @@index([childId])
  @@index([badgeSlug])
}

model Squad {
  id               String        @id @default(cuid())
  name             String
  theme            String
  description      String
  icon             String        @default("🌟")
  countries        String        @default("[]")
  featuredEntryIds String        @default("[]")
  status           String        @default("active")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  members          SquadMember[]

  @@index([theme])
  @@index([status])
}

model SquadMember {
  id       String   @id @default(cuid())
  squadId  String
  childId  String
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id])
  child Child @relation(fields: [childId], references: [id])

  @@unique([squadId, childId])
  @@index([childId])
}

model ParentChild {
  id                 String   @id @default(cuid())
  userId             String
  childId            String
  claimedAt          DateTime @default(now())
  /// Timestamp when the parent gave verifiable consent for the child's account.
  /// Required for COPPA compliance. Set at account creation time.
  consentGivenAt     DateTime @default(now())
  /// Version of the privacy policy/consent text accepted.
  /// Bump when consent language materially changes — triggers re-consent flow.
  consentTextVersion String   @default("v1")

  user  User  @relation(fields: [userId], references: [id])
  child Child @relation(fields: [childId], references: [id])

  @@unique([userId, childId])
  @@index([userId])
  @@index([childId])
}

model ParentReport {
  id              String   @id @default(cuid())
  parentId        String
  childId         String
  type            String // "weekly", "biweekly"
  period          String // JSON: { start: ISO, end: ISO }
  strengths       String // JSON array of strings
  growthAreas     String // JSON array of strings
  tips            String // JSON array of tip objects
  summary         String // AI-generated narrative
  badgeHighlights String // JSON: badge names earned
  metadata        String? // JSON: additional context
  createdAt       DateTime @default(now())

  parent User  @relation(fields: [parentId], references: [id])
  child  Child @relation(fields: [childId], references: [id])

  @@index([parentId])
  @@index([childId])
  @@index([createdAt])
}

model ParentQuestFollow {
  id            String   @id @default(cuid())
  parentId      String
  childId       String
  questId       String
  currentDay    Int      @default(1)
  lastViewedAt  DateTime @default(now())
  notifications Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent User  @relation(fields: [parentId], references: [id])
  child  Child @relation(fields: [childId], references: [id])
  quest  Quest @relation(fields: [questId], references: [id])

  @@unique([parentId, questId])
  @@index([parentId])
  @@index([questId])
}

model ChildZpdState {
  id        String   @id @default(cuid())
  childId   String   @unique
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  score     Float    @default(0.30)
  band      String   @default("developing")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([childId])
}

model ChildZpdSnapshot {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  score     Float
  band      String
  missionId String?
  reason    String   // "baseline" | "mission_completed" | "reflection_submitted" | "frustration_sustained" | "mission_abandoned"
  createdAt DateTime @default(now())

  @@index([childId, createdAt])
  @@index([missionId])
}

/// Inter-rater reliability rating: human expert label vs. AI label at rating time.
/// Used to compute Cohen's Kappa (≥0.6 target). Spec ref: Katalis.docx §1.3.
model DiscoveryRating {
  id                    String    @id @default(cuid())
  discoveryId           String
  discovery             Discovery @relation(fields: [discoveryId], references: [id])
  raterUserId           String
  rater                 User      @relation(fields: [raterUserId], references: [id])
  /// JSON-encoded string arrays.
  humanInterestKeys     String
  humanTagCategories    String
  aiInterestKeysAtRate  String
  aiTagCategoriesAtRate String
  notes                 String?
  createdAt             DateTime  @default(now())

  @@unique([discoveryId, raterUserId])
  @@index([createdAt])
}

/// Periodic Cohen's Kappa snapshot per layer (e.g. interest_keys, tag_categories).
model ReliabilitySnapshot {
  id           String             @id @default(cuid())
  computedAt   DateTime           @default(now())
  layer        String
  kappa        Float
  sampleSize   Int
  payloadJson  String
  triggeredBy  String
  alerts       ReliabilityAlert[]

  @@index([layer, computedAt])
}

/// Fires when a layer's Kappa drops below the threshold (default 0.6).
model ReliabilityAlert {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  layer          String
  kappa          Float
  sampleSize     Int
  snapshotId     String
  snapshot       ReliabilitySnapshot @relation(fields: [snapshotId], references: [id])
  acknowledgedAt DateTime?
  acknowledgedBy String?
  ackUser        User?               @relation(fields: [acknowledgedBy], references: [id])

  @@index([layer, createdAt])
  @@index([acknowledgedAt])
}
